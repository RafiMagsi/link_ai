rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /userSettings/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /appConfig/{documentId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 280
        && request.resource.data.media is list
        && request.resource.data.media.size() <= 4;

      allow update: if isSignedIn();
      allow delete: if isAdmin() ||
        resource.data.authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;

        allow update: if false;
        allow delete: if isAdmin() ||
          resource.data.authorUid == request.auth.uid;
      }
    }

    match /postLikes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /postReposts/{repostId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /postSaves/{saveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /connectRequests/{requestId} {
      allow read: if isSignedIn()
        && (
          resource.data.senderUid == request.auth.uid ||
          resource.data.receiverUid == request.auth.uid
        );

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /connections/{connectionId} {
      allow read: if isSignedIn()
        && resource.data.userUid == request.auth.uid;

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /userConnectionStats/{uid} {
      allow read: if isOwner(uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if (resource.data.visibility == "public"
          && resource.data.status == "active")
        || isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.tagline is string
        && request.resource.data.tagline.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 3000;

      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.tagline is string
        && request.resource.data.tagline.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 3000
        && request.resource.data.visibility in ["public", "unlisted"]
        && request.resource.data.status in ["active", "archived"];

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /productSaves/{saveId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow update: if false;
    }
  }
}
