rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function userModerationPath(uid) {
      return /databases/$(database)/documents/userModeration/$(uid);
    }

    function isActiveUser(uid) {
      return !exists(userModerationPath(uid))
        || !(
          get(userModerationPath(uid)).data.status in ["suspended", "banned"]
        );
    }

    function isVisiblePost(postData) {
      return !postData.keys().hasAny(["visibility"])
        || postData.visibility == "active";
    }

    function isBlockedPair(uidA, uidB) {
      return exists(/databases/$(database)/documents/userBlocks/$(uidA + "_" + uidB))
        || exists(/databases/$(database)/documents/userBlocks/$(uidB + "_" + uidA));
    }

    // Explicit collectionGroup rules for comments
    match /posts/{postId}/comments/{commentId} {
      allow read: if isVisiblePost(
        get(/databases/$(database)/documents/posts/$(postId)).data
      );
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && isActiveUser(request.auth.uid);
      allow update: if isOwner(uid) && isActiveUser(request.auth.uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /userModeration/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /userSettings/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /appConfig/{documentId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if isVisiblePost(resource.data)
        || isAdmin()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && (request.resource.data.postType == 'commentRepost' || request.resource.data.text.size() <= 280)
        && request.resource.data.hashtags is list
        && request.resource.data.hashtags.size() <= 20
        && request.resource.data.media is list
        && request.resource.data.media.size() <= 4;

      allow update: if isSignedIn() && isActiveUser(request.auth.uid);
      allow delete: if isAdmin() ||
        resource.data.authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isVisiblePost(
          get(/databases/$(database)/documents/posts/$(postId)).data
        );
        allow create: if isSignedIn()
          && isActiveUser(request.auth.uid)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && !isBlockedPair(
            request.auth.uid,
            get(/databases/$(database)/documents/posts/$(postId)).data.authorUid
          );

        allow update: if isSignedIn()
          && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['likesCount', 'repostsCount', 'savesCount']);

        allow delete: if isAdmin() ||
          resource.data.authorUid == request.auth.uid;
      }
    }

    match /postLikes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && !isBlockedPair(
          request.auth.uid,
          get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.authorUid
        );
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /postReposts/{repostId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && !isBlockedPair(
          request.auth.uid,
          get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.authorUid
        );
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /postSaves/{saveId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && saveId.matches('^.*_' + request.auth.uid + '$')
          && (resource == null || resource.data.uid == request.auth.uid)
        );

      allow create: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.id == saveId
        && !isBlockedPair(
          request.auth.uid,
          get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.authorUid
        );

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow update: if false;
    }

    match /commentLikes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.commentId is string
        && request.resource.data.postId is string;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /commentReposts/{repostId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.commentId is string
        && request.resource.data.postId is string;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /commentSaves/{saveId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && saveId.matches('^.*_' + request.auth.uid + '$')
          && (resource == null || resource.data.uid == request.auth.uid)
        );

      allow create: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.commentId is string
        && request.resource.data.postId is string
        && request.resource.data.id == saveId;

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow update: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && request.resource.data.type is string
        && request.resource.data.type in ["post", "user"]
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == "open";
      allow update: if isAdmin()
        && request.resource.data.status in ["open", "resolved", "dismissed", "actioned"]
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly([
            "status",
            "resolvedAt",
            "resolvedBy",
            "actionType",
            "actionAt",
            "actionBy"
          ]);
      allow delete: if isAdmin();
    }

    match /userBlocks/{blockId} {
      allow read: if isSignedIn()
        && blockId.matches('^' + request.auth.uid + '_.*')
        && (resource == null || resource.data.blockerUid == request.auth.uid);

      allow create: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.id == blockId
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUid;

      allow update: if false;

      allow delete: if isSignedIn()
        && resource.data.blockerUid == request.auth.uid;
    }

    match /connections/{connectionId} {
      // A user can read their own following edges and follower edges pointing
      // to them. Guard against `resource` being null on non-existent docs.
      allow read: if isSignedIn()
        && (
          connectionId.matches('^' + request.auth.uid + '_.*')
          || (resource != null && resource.data.connectedUid == request.auth.uid)
        )
        && (
          resource == null
          || resource.data.userUid == request.auth.uid
          || resource.data.connectedUid == request.auth.uid
        );

      allow create: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.connectedUid is string
        && request.resource.data.id == connectionId
        && connectionId == request.auth.uid + '_' + request.resource.data.connectedUid
        && !isBlockedPair(request.auth.uid, request.resource.data.connectedUid)
        && request.resource.data.keys().hasOnly([
          "id",
          "userUid",
          "connectedUid",
          "createdAt"
        ]);

      allow update: if false;

      allow delete: if isSignedIn()
        && resource.data.userUid == request.auth.uid;
    }

    match /savedProfiles/{saveId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && saveId.matches('^.*_' + request.auth.uid + '$')
          && (resource == null || resource.data.uid == request.auth.uid)
        );

      allow create: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.profileUid is string
        && request.resource.data.id == saveId;

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow update: if false;
    }

    match /userConnectionStats/{uid} {
      allow read: if isOwner(uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && resource.data.participantUids.hasAny([request.auth.uid]);

      allow create: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && request.resource.data.participantUids.hasAll([request.auth.uid])
        && request.resource.data.participantUids.size() == 2;

      allow update: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && resource.data.participantUids.hasAny([request.auth.uid]);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/conversations/$(conversationId))
               .data.participantUids.hasAny([request.auth.uid]);

        allow create: if isSignedIn()
          && isActiveUser(request.auth.uid)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow update: if false;
        allow delete: if false;
      }
    }

    match /products/{productId} {
      allow read: if (resource.data.visibility == "public"
          && resource.data.status == "active")
        || isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.tagline is string
        && request.resource.data.tagline.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 3000;

      allow update: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.tagline is string
        && request.resource.data.tagline.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 3000
        && request.resource.data.visibility in ["public", "unlisted"]
        && request.resource.data.status in ["active", "archived"];

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /productSaves/{saveId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && saveId.matches('^.*_' + request.auth.uid + '$')
          && (resource == null || resource.data.uid == request.auth.uid)
        );

      allow create: if isSignedIn()
        && isActiveUser(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.id == saveId;

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow update: if false;
    }

    match /users/{uid}/fcmTokens/{tokenId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.receiverUid == request.auth.uid;

      allow create: if false;

      allow update: if isSignedIn()
        && resource.data.receiverUid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["isRead"]);

      allow delete: if isSignedIn()
        && resource.data.receiverUid == request.auth.uid;
    }

    match /users/{uid}/subscription/{docId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }
  }
}
