# IntelliJ related
*.iml
*.ipr
*.iws
.idea/
docs/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default. For most apps it's not needed in git.
.vscode/
*.code-workspace

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.fvm/
.pub-cache/
.pub/
/build/
/coverage/

# Node / npm related
**/node_modules/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android (Gradle/NDK) related
.gradle/
**/local.properties
**/.cxx/
**/captures/

# iOS/macOS (Xcode/CocoaPods) related
**/Pods/
**/.symlinks/
**/Flutter/ephemeral/
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh
**/xcuserdata/
**/*.xcuserstate

# Release artifacts
*.apk
*.aab
*.ipa
*.dSYM.zip
*.dSYM

# Signing keys / certificates (keep out of git)
*.jks
*.keystore
*.p12
*.pem
*.cer
*.crt
*.key
*.mobileprovision

# Firebase project-specific config (keep out of git)
.firebaserc
.firebase/
firebase-debug.log
serviceAccountKey.json

# FlutterFire generated options (contains project ids + api keys)
lib/firebase_options.dart

# Firebase native config files
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# (Optional) ignore these files anywhere in the repo
**/google-services.json
**/GoogleService-Info.plist
